  },
  "variable": [
    { "key": "odooBaseUrl", "value": "https://your-odoo-api.example.com", "type": "string" },
    { "key": "odooApiKey", "value": "", "type": "string" },
    { "key": "companyId", "value": "", "type": "string" },
    { "key": "searchBaseUrl", "value": "https://your-odoo-search-api.example.com", "type": "string" },
    { "key": "searchApiKey", "value": "", "type": "string" },
    { "key": "fileUploadBaseUrl", "value": "https://your-odoo-files-api.example.com", "type": "string" },
    { "key": "contactId", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
